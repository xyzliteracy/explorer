{
  "name": "xyz-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "XYZDSL explorer \u2014 primary public-release application.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "assets:decoders": "node scripts/copy-decoders.mjs",
