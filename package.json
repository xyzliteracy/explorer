    "three": "^0.181.2",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.8.3",
    "three-stdlib": "^2.36.1",
    "@xyz/viewer": "file:../xyz-viewer"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
