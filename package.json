    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "draco3d": "^1.5.7",
    "jsdom": "^29.1.1",
