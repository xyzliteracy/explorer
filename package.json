    "test:decoders": "node --test scripts/basis-csp.test.mjs",
    "assets:inspect": "node scripts/inspect-models.mjs",
    "core:update": "node scripts/update-core.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.1",
